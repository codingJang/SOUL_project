{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "uv sync"
  },
  "deploy": {
    "startCommand": "uvicorn src.webapp:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100
  },
  "variables": {
    "NIXPACKS_PYTHON_VERSION": "3.11"
  }
}